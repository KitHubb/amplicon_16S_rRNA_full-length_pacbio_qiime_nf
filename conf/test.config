// Actual QC regression; synthetic reads are unsuitable for DADA2 error learning.
params {
    input = "${projectDir}/tests/data/samplesheet.csv"
    outdir = 'results/test'
    run_label = 'test'
    taxonomy_enabled = false
    phylogeny_enabled = false
    stop_after_qc = true
}
process {
    withName: '.*' {
        cpus = 2
        memory = '2 GB'
        time = '10m'
    }
}
executor.queueSize = 2
