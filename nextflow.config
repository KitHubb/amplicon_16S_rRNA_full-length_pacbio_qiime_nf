nextflow.enable.dsl = 2

params {
    input = null
    outdir = 'results'
    run_label = 'production'

    // Optional legacy local SIF overrides (Singularity/Apptainer only).
    qc_sif = null
    cutadapt_sif = null
    qiime_sif = null
    fastqc_container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
    multiqc_container = 'quay.io/biocontainers/multiqc:1.27.1--pyhdfd78af_0'
    cutadapt_container = 'quay.io/biocontainers/cutadapt:5.2--py310h1fe012e_0'
    qiime_container = 'quay.io/qiime2/amplicon:2025.7'
    stop_after_qc = false

    // Cleanup defaults reproduce the previously used PacBio QC script,
    // with poly-A added alongside poly-G.
    cleanup_quality_cutoff = 30
    cleanup_min_length = 100
    cleanup_poly_g_min_run = 10
    cleanup_poly_a_min_run = 10

    // Previously validated full-length 16S primer sequences.
    // Primer orientation and removal are handled by dada2 denoise-ccs.
    dada2_front = 'AGRGTTYGATYMTGGCTCAG'
    dada2_adapter = 'RGYTACCTTGTTACGACTT'
    dada2_min_len = 1000
    dada2_max_len = 1600

    // Taxonomy can be disabled until the classifier is available.
    taxonomy_enabled = true
    taxonomy_reference_id = 'silva_138_99'
    taxonomy_classifier = null
    taxonomy_confidence = 0.8
    taxonomy_reads_per_batch = 'auto'

    // Phylogeny is enabled by default and can be disabled with
    // --phylogeny_enabled false.
    phylogeny_enabled = true
}

process {
    executor = 'local'
    shell = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = 'terminate'

    withLabel: input_prep {
        cpus = 2
        memory = 4.GB
        maxForks = 4
    }

    withLabel: qc {
        cpus = 4
        memory = 8.GB
        maxForks = 4
    }

    withLabel: read_cleanup {
        cpus = 4
        memory = 8.GB
        maxForks = 4
    }

    withLabel: qiime_import {
        cpus = 2
        memory = 8.GB
    }

    withLabel: qiime_dada2 {
        cpus = 16
        memory = 32.GB
    }

    withLabel: qiime_summary {
        cpus = 2
        memory = 8.GB
    }

    withLabel: qiime_taxonomy {
        cpus = 16
        memory = 32.GB
    }

    withLabel: qiime_phylogeny {
        cpus = 8
        memory = 16.GB
    }
}

manifest {
    name = 'KitHubb/amplicon_16S_rRNA_full-length_pacbio_qiime_nf'
    description = 'PacBio full-length 16S CCS analysis with QIIME 2'
    version = '0.0.9'
    nextflowVersion = '>=26.04.2'
}

profiles {
    docker {
        docker.enabled = true
        singularity.enabled = false
        apptainer.enabled = false
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        docker.enabled = false
        singularity.enabled = true
        apptainer.enabled = false
        singularity.autoMounts = true
        executor.queueSize = 4
    }
    apptainer {
        docker.enabled = false
        singularity.enabled = false
        apptainer.enabled = true
        apptainer.autoMounts = true
        executor.queueSize = 4
    }
    test { includeConfig 'conf/test.config' }
    test_full { includeConfig 'conf/test_full.config' }
    test_stub {
        includeConfig 'conf/test_full.config'
        docker.enabled = false
        singularity.enabled = false
        apptainer.enabled = false
    }
}
